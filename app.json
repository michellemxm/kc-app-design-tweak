{
  "name": "poke-and-prose",
  "version": "0.7.1",
  "repository": "https://github.com/michellemxm/kc-app-design-tweak",
  "displayName": "Design Tweak",
  "iconUrl": "/apps/poke-and-prose/ui/icon.svg",
  "description": "Visually select elements in your live app preview and turn them into scoped, source-mapped edit requests for the agent — like Figma comments, but for code.",
  "author": "mxiaomen",
  "license": "MIT",
  "tags": [
    "design",
    "frontend",
    "preview",
    "visual-editing",
    "productivity"
  ],
  "defaultEnabled": false,
  "minKiroCrewVersion": "0.1.0",
  "skills": [
    "skills/visual-edit"
  ],
  "permissions": {
    "api": [
      "/apps/poke-and-prose/api"
    ],
    "events": [
      "visual-edit:request"
    ],
    "storage": true,
    "network": true,
    "cron": true
  },
  "ui": {
    "entry": "index.mjs",
    "pages": [
      {
        "route": "/poke-and-prose",
        "label": "Design Tweak",
        "icon": "Paintbrush",
        "iconUrl": "icon.svg"
      }
    ]
  },
  "backend": {
    "entryPoint": "backend/server.py",
    "port": "auto",
    "healthCheck": "/health"
  },
  "platform": {
    "os": [
      "macos",
      "linux"
    ]
  }
}
